{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../types.ts",
    "../constants.tsx",
    "../engine/*.ts"
  ],
  "exclude": [
    "node_modules",
    "../engine/*.test.ts",
    "../engine/web.ts",
    "../engine/lens-renderer.ts",
    "../engine/capture.ts",
    "../engine/face-landmarker.ts"
  ]
}
